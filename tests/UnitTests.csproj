<Project Sdk="Microsoft.NET.Sdk">

  <!-- Юнит-тесты: компилируются вместе с src (доступ к internal), свой мини-раннер
       (StartupObject). PdfSharp кладётся рядом на случай резолва. -->
  <!-- Разрядность — как у приложения (build_tests.cmd x86). Без этого обе ветки матрицы CI
       гоняли один и тот же 64-битный exe, и ветки IntPtr.Size == 4 (половинные размеры кэшей
       документов и страниц) не проверялись НИ РАЗУ. Своя пара obj/bin на разрядность: в общем
       каталоге инкрементальная очистка MSBuild сносила бы выход другой. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>$(Arch)</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>UnitTests</AssemblyName>
    <RootNamespace>ExcelMerger</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>ExcelMerger.Tests.UnitTests</StartupObject>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <OutputPath Condition="'$(Arch)' == 'x64'">bin\</OutputPath>
    <OutputPath Condition="'$(Arch)' != 'x64'">bin\$(Arch)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" />
    <Compile Include="UnitTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PdfSharp">
      <HintPath>..\build\PdfSharp.dll</HintPath>
    </Reference>
    <!-- PdfPig (для компиляции src\PdfTextExtract.cs); резолв в рантайме — из ресурсов exe -->
    <Reference Include="UglyToad.PdfPig">
      <HintPath>..\build\pdfpig\UglyToad.PdfPig.dll</HintPath>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Core">
      <HintPath>..\build\pdfpig\UglyToad.PdfPig.Core.dll</HintPath>
    </Reference>
    <!-- Tokens: тип DictionaryToken у IPdfImage.ImageDictionary (см. src\PdfTextExtract.cs) -->
    <Reference Include="UglyToad.PdfPig.Tokens">
      <HintPath>..\build\pdfpig\UglyToad.PdfPig.Tokens.dll</HintPath>
    </Reference>
    <!-- System.Memory: тип ReadOnlyMemory в IPdfImage.RawBytes (см. src\PdfTextExtract.cs) -->
    <Reference Include="System.Memory">
      <HintPath>..\build\pdfpig\System.Memory.dll</HintPath>
    </Reference>
    <!-- ZipArchive (сборка .pptx в src\OoxmlPackage.cs) — см. пояснение в iwoHelperDesktop.csproj -->
    <Reference Include="System.IO.Compression" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- ТОЛЬКО ДЛЯ ТЕСТОВ: официальный валидатор Open XML. Проверяет собранный .pptx по схеме
         и ловит то, на что PowerPoint отвечает лишь «файл повреждён» без подробностей.
         В приложение НЕ входит: iwoHelperDesktop.csproj этой ссылки не имеет, и отдельный
         тест следит, чтобы имя пакета не всплыло в src\. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
