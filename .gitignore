# Артефакты сборки
dist/
selftest.log

# Ghostscript, подготовленный tools\stage_gs.ps1 для установщика
# (крупные бинарники ~40 МБ — в репозиторий не кладём; gs32 — 32-битный вариант)
installer/gs/
installer/gs32/

# Промежуточные файлы dotnet/MSBuild
obj/
tests/bin/
tests/obj/
*.user

# Тестовые артефакты (генерируются tests/make_testdata.ps1 и прогонами)
tests/testdata/
tests/allsheets_in/
tests/out/
tests/icon_preview.png
*.report.txt

# Windows
Thumbs.db
desktop.ini
tests/retrydata/

# Временные файлы-лок-файлы офисных редакторов (~$*.docx): случайный артефакт
# открытого документа в репозиторий не уходит
~$*.docx
~$*.doc
.claude/

# Рабочие планы (не для репозитория)
docs/Plan OCR.md
docs/Plan_*.md

# Справочные скриншоты чужих репозиториев и прочий временный мусор в корне
/1.png
/2.png
/3.png
/screenshots/
# Рабочий PDF → Word-корпус и его распакованные/сгенерированные артефакты никогда
# не попадают в Git. Отдельное правило оставлено намеренно, даже при общем _tmp_*.
/_tmp_pdfword/
_tmp_*

# Рабочий корпус для ручных проверок: содержимое наружу не выходит ни файлами,
# ни цитатами в коммитах, тестах и документации
Example/
# Отдельные файлы, брошенные в корень для проверки руками (документы, презентации,
# снимки экрана): в репозиторий не уходят
/*.pdf
/*.pptx
/*.docx
/*.png
/*.jpg
/*.jpeg

# Сборка руководства: исходники конвейера в репозитории, а его вывод — нет.
# Снимки и образцы делаются заново одной командой, а .exe пробника собирается из .cs.
tools/manual/shots-*/
tools/manual/samples-*/
tools/manual/Shots.exe
tools/manual/loc_*.json
tools/manual/_toc_*.docx
__pycache__/
