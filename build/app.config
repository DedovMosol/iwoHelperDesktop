<?xml version="1.0" encoding="utf-8"?>
<!-- Ships beside the exe as iwoHelperDesktop.exe.config (portable zip and installer).
     DpiAwareness=PerMonitorV2 is the documented .NET Framework 4.7+ switch for WinForms
     high-DPI support: WinForms itself sets the process awareness and rescales windows on
     WM_DPICHANGED. The manifest must NOT declare dpiAware/dpiAwareness: it would override
     this file. Without the file the process is DPI-unaware and Windows bitmap-stretches
     the windows (blurry, but the layout stays intact). The selftest mode checks it (exit 5).
     https://learn.microsoft.com/dotnet/desktop/winforms/high-dpi-support-in-windows-forms -->
<configuration>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
